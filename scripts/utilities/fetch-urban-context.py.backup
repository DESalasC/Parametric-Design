#!/usr/bin/env python3
# ==============================================================================
# fetch-urban-context.py
# ------------------------------------------------------------------------------
# Script para extraer el contexto urbano y topográfico de un lote dado su CHIP.
# Genera un JSON estructurado que sirve como puente entre los datos GIS y Grasshopper.
#
# Uso:
#   python fetch-urban-context.py --chip <CHIP> [--dem <path_to_dem>]
#
# Requisitos:
#   pip install pyogrio shapely click rasterio numpy
#
# Salida:
#   data/pot-cache/<CHIP>-contexto.json
#
# Estructura del JSON de salida (según ADR-007):
#   {
#     "metadata": {
#       "chip": "...",
#       "origen_sirgas": {
#         "crs": "EPSG:9377",
#         "x": <float>,
#         "y": <float>,
#         "z": <float>
#       },
#       "azimuth_norte_grados": <float>,
#       "buffer_metros": <float>
#     },
#     "topografia": {
#       "estado": "ESTIMADA" | "PENDIENTE",
#       "fuente": "IDECA_MDE" | null,
//       "malla_terreno": [
//         {"id": "P001", "x_local": <float>, "y_local": <float>, "z_local": <float>},
//         ...
//       ]
//     },
//     "lote_objetivo": {
//       "vertices_3d_local": [[<float>, <float>, <float>], ...],
//       "area_m2": <float>
//     },
//     "vecinos": [
//       {
//         "chip": "<CHIP>",
//         "vertices_3d_local": [[<float>, <float>, <float>], ...],
//         "altura_estimada_m": <float> | null,
//         "num_pisos": <int> | null
//       }
//     ],
//     "vias": [
//       {
//         "tipo": <string>,
//         "eje_linea_local": [[<float>, <float>, <float>], [<float>, <float>, <float>]]
//       }
//     ]
//   }
// ==============================================================================

