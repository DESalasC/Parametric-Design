                            <item name="Description" type_name="gh_string" type_code="10">The folder in which the Radiance commands are executed to
produce the sky matrix. If None, it will be written to Ladybug's
default EPW folder.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">fbb2cb29-0157-4835-9a42-7103a7f486ad</item>
