                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
AUTOR: Escáner y Etiquetador Dinámico Universal de Componentes Grasshopper
Entrada: 
  - run: Boolean (True para escanear y renombrar todos)
Salidas:
  - inventario: Lista de texto con todos los componentes y sus IDs
  - total_componentes: Conteo total de nodos encontrados
"""
import Grasshopper as gh
import System

doc = ghenv.Component.OnPingDocument()

inventario = []
total_componentes = 0

if doc and run:
    # 1. Obtener todos los objetos del canvas excluyendo este propio componente
    todos_los_objetos = [
        obj for obj in doc.Objects 
        if obj.InstanceGuid != ghenv.Component.InstanceGuid
    ]
    
    # 2. Ordenar de izquierda a derecha y arriba a abajo según posición en canvas
    todos_los_objetos.sort(
        key=lambda o: (round(o.Attributes.Pivot.X, -1), round(o.Attributes.Pivot.Y, -1)) 
        if hasattr(o, "Attributes") and o.Attributes else (0, 0)
    )

    contador = 1
    for obj in todos_los_objetos:
        if not hasattr(obj, "Attributes") or obj.Attributes is None:
            continue
        
        # Ignorar grupos visuales si no son componentes
        if type(obj).__name__ in ["GH_Group"]:
            continue

        nombre_base = getattr(obj, "Name", "Componente")
        tipo_clase = type(obj).__name__
        guid_corto = str(obj.InstanceGuid)[:8]
        pos_x = int(obj.Attributes.Pivot.X)
        pos_y = int(obj.Attributes.Pivot.Y)

        # 3. Si es un script GhPython, inspeccionar si tiene nombre de archivo .py en su código
        nombre_script = ""
        if hasattr(obj, "Code") and obj.Code:
            codigo = str(obj.Code)
            for linea in codigo.splitlines()[:15]:
                linea_str = linea.strip()
                if "F1_" in linea_str or ".py" in linea_str:
                    for token in linea_str.replace('"', ' ').replace("'", " ").replace("#", " ").split():
                        if "F1_" in token or token.endswith(".py"):
                            nombre_script = token
                            break
                    if nombre_script:
                        break

        # 4. Formatear la nueva etiqueta (Fancy Text / Bifocals)
        if nombre_script:
            etiqueta = "#{}-{}".format(contador, nombre_script)
        else:
            etiqueta = "#{}-{}".format(contador, nombre_base)

        # 5. Aplicar la etiqueta al NickName del componente
        if hasattr(obj, "NickName"):
            obj.NickName = etiqueta
            obj.Attributes.ExpireLayout()

        # 6. Registrar en el inventario de salida
        linea_registro = "{:03d} | {:&lt;35} | GUID: {} | Pos: ({}, {})".format(
            contador, etiqueta, guid_corto, pos_x, pos_y
        )
        inventario.append(linea_registro)
        contador += 1

    total_componentes = len(inventario)

    # 7. Refrescar el canvas visualmente
    doc.NewSolution(False)
    print("Escaneo completado: {} componentes etiquetados.".format(total_componentes))</item>
