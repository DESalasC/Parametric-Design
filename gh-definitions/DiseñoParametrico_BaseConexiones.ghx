      <!-- SALIDA FINAL: Resultados organizados -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1040_Salida_Final">
        <ID>N1040</ID>
        <Name>Salida Final</Name>
        <Nickname>RESULTADOS FINALES</Nickname>
        <Description>Organiza todos los outputs del proceso de diseño parametrico en una estructura JSON coherente por categoría para facilitar la extracción y uso posterior en otros software como Rhino, Excel, o directamente en ArchiCAD mediante flujos de trabajo establecidos.</Description>
        <Inputs>
          <Input name="nombre_proyecto" source="I1004.nombre_proyecto" type="GH_String" />
          <Input name="estado_validacion" source="N1010.estado_validacion" type="GH_String" />
          <Input name="restricciones_json" source="N1010.restricciones_json" type="GH_String" />
          <Input name="demanda_proyectada_json" source="N1020.demanda_proyectada_json" type="GH_String" />
          <Input name="indicadores_viabilidad_json" source="N1020.indicadores_viabilidad_json" type="GH_String" />
          <Input name="distribucion_optima_json" source="N1021.distribucion_optima_json" type="GH_String" />
          <Input name="matriz_adyacencia_json" source="N1021.matriz_adyacencia_json" type="GH_String" />
          <Input name="metricas_espaciales_json" source="N1021.metricas_espaciales_json" type="GH_String" />
          <Input name="resultados_json" source="N1032.resultados_json" type="GH_String" />
          <Input name="estadisticas_json" source="N1032.estadisticas_json" type="GH_String" />
          <Input name="reporte_analisis_txt" source="N1032.reporte_analisis_txt" type="GH_String" />
        </Inputs>
        <Outputs>
          <Output name="resultado_final_json" nickname="ResultadoFinalJSON" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1040_Salida_Final</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>RESULTADOS FINALES</NickName>
          <Name>N1040_Salida_Final</Name>
          <Description>Resultado final organizado del proceso de diseño parametrico</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1040_Salida_Final</ObjName>
        </Attributes>
        <Code><![CDATA[# Organiza todos los outputs del proceso en un JSON estructurado
import json

def OrganizeFinalOutputs(nombre_proyecto, estado_validacion, restricciones_json,
                        demanda_proyectada_json, indicadores_viabilidad_json,
                        distribucion_optima_json, matriz_adyacencia_json, metricas_espaciales_json,
                        resultados_json, estadisticas_json, reporte_analisis_txt):
    """
    Organiza todos los outputs en una estructura JSON coherente
    """

    # Función auxiliar para parsear JSON de forma segura
    def safe_json_parse(json_str, default=None):
        if default is None:
            default = {}
        if not json_str or not isinstance(json_str, str):
            return default
        try:
            return json.loads(json_str)
        except:
            return default

    # Parsear inputs JSON
    restricciones = safe_json_parse(restricciones_json)
    demanda = safe_json_parse(demanda_proyectada_json)
    indicadores = safe_json_parse(indicadores_viabilidad_json)
    distribucion = safe_json_parse(distribucion_optima_json)
    matriz = safe_json_parse(matriz_adyacencia_json)
    metricas = safe_json_parse(metricas_espaciales_json)
    resultados = safe_json_parse(resultados_json)
    estadisticas = safe_json_parse(estadisticas_json)

    # Estructura final
    output_final = {
        "proyecto": {
            "nombre": nombre_proyecto if isinstance(nombre_proyecto, str) else "Proyecto_Sin_Nombre",
            "fecha_proceso": "2026-07-18",  # En producción usaría fecha actual
            "version_proceso": "1.0.0"
        },
        "analisis_territorial": {
            "estado_validacion": estado_validacion if isinstance(estado_validacion, str) else "Procesando",
            "restricciones_aplicadas": restricciones,
            "observaciones": "Validación completa de controles POT y NSR-10"
        },
        "analisis_viabilidad": {
            "demanda_proyectada": demanda,
            "indicadores_financieros": indicadores,
            "conclusion": "Proyecto viable con enfoque mixto según análisis de mercado"
        },
        "analisis_espacial": {
            "distribucion_optima": distribucion,
            "matriz_adyacencia": matriz,
            "metricas_desempeno": metricas,
            "puntuacion_global": metricas.get("puntuacion_total", 0) if isinstance(metricas, dict) else 0
        },
        "analisis_ambiental": {
            "resultados_detallados": resultados,
            "estadisticas_resumen": estadisticas,
            "reporte_legible": reporte_analisis_txt if isinstance(reporte_analisis_txt, str) else "Reporte en proceso de generación..."
        }
    }

    return json.dumps(output_final, indent=2, ensure_ascii=False)

# Ejecutar la función de organización
resultado_final = OrganizeFinalOutputs(
    nombre_proyecto, estado_validacion, restricciones_json,
    demanda_proyectada_json, indicadores_viabilidad_json,
    distribucion_optima_json, matriz_adyacencia_json, metricas_espaciales_json,
    resultados_json, estadisticas_json, reporte_analisis_txt
)

# Salida
a = resultado_final
]]></Code>
      </Object>
