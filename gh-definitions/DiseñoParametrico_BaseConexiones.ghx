      <!-- CLUSTER: ANÁLISIS TERRITORIAL (Capa 0 y 1) -->
      <Object type="Grasshopper.Kernel.Special.GH_Group" name="G1_Analisis_Territorial">
        <Name>GRUPO 1: ANÁLISIS TERRITORIAL</Name>
        <Nickname>GRUPO 1: ANÁLISIS TERRITORIAL</Nickname>
        <Color>#3881B8</Color>
        <Description>Análisis de contexto territorial: POT, NSR-10, validación cruzada de regulaciones</Description>
        <MemberIds>N1005,N1006,N1007,N1010</MemberIds>
      </Object>

      <!-- VALIDADOR CRUZADO v01 (Layer 1 - Territorial Core) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1010_Validador_Cruzado">
        <ID>N1010</ID>
        <Name>Validador Cruzado POT/NSR-10</Name>
        <Nickname>VALIDADOR CRUZADO</Nickname>
        <Description>Valida consistencia entre regulaciones POT y NSR-10. Procesa las entradas de lote, calles y vecinos para determinar restricciones territoriales aplicables. Output: JSON con restricciones y estado de validación.</Description>
        <Inputs>
          <Input name="pot_conclusions" source="N1005.pot_conclusions" type="GH_String" />
          <Input name="vecino_analisis" source="N1007.vecino_analisis_json" type="GH_String" />
          <Input name="lote_id" source="I1004.nombre_proyecto" type="GH_String" />
        </Inputs>
        <Outputs>
          <Output name="restricciones_json" nickname="RestriccionesJSON" type="GH_String" />
          <Output name="estado_validacion" nickname="EstadoValidación" type="GH_String" />
          <Output name="resumen_validacion" nickname="ResumenValidación" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1010_Validador_Cruzado</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>VALIDADOR CRUZADO</NickName>
          <Name>N1010_Validador_Cruzado</Name>
          <Description>Valida consistencia entre regulaciones POT y NSR-10</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1010_Validador_Cruzado</ObjName>
        </Attributes>
        <Code><![CDATA[# VALIDADOR_CRUZADO_v01.py - Referencia: C:\Users\Dario Salas\proyectos\DiseñoParametrico_sistema\src\layer1_territorial_core\VALIDADOR_CRUZADO_v01.py
