exec(open(os.path.join(script_dir, "CTX_POT_BOGOATA_v04.py")).read())]]></Code>
      </Object>

      <!-- CAPA 1: CONFIGURACIÓN DE LADOS DEL LOTE -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1006_Lados_Configurar">
        <ID>N1006</ID>
        <Name>Configuración de Lados</Name>
        <Nickname>LADOS_CONFIGURAR</Nickname>
        <Description>Clasificación automática de lados del lote (frontal, posterior, lateral) basada en el análisis POT. Calcula retiros normativos, permisos de balcones y genera configuración para cumplimiento regulatorio.</Description>
        <Inputs>
          <Input name="lot_polygon" source="I1000.lote_curva" type="GH_Curve" />
          <Input name="lot_segments" type="GH_String" nickname="Segmentos Lote" />
          <Input name="lot_midpoints" type="GH_String" nickname="Puntos Medios Lote" />
          <Input name="street_curves" source="I1001.calles_curvas" type="GH_Curve" listAccess="True" />
          <Input name="pot_conclusions" source="N1005.pot_conclusions" type="GH_String" />
          <Input name="floors_per_tower" type="GH_Integer" nickname="Pisos por Torre" value="4" />
          <Input name="bonus_floor" type="GH_Boolean" nickname="Piso de Bonificación" value="False" />
        </Inputs>
        <Outputs>
          <Output name="sides_table" nickname="SidesTableJSON" type="GH_String" />
          <Output name="pot_compliance" nickname="POTComplianceJSON" type="GH_String" />
          <Output name="balcony_rules_summary" nickname="BalconyRulesSummary" type="GH_String" />
          <Output name="resultado_json_string" nickname="ResultadoJSON" type="GH_String" />
          <Output name="vecino_analisis_json" nickname="VecinoAnalisisJSON" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1006_Lados_Configurar</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>LADOS_CONFIGURAR</NickName>
          <Name>N1006_Lados_Configurar</Name>
          <Description>Clasificación automática de lados del lote</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1006_Lados_Configurar</ObjName>
        </Attributes>
        <Code><![CDATA[# LADOS_CONFIGURAR_v03 - Clasificacion automatica de lados del lote
