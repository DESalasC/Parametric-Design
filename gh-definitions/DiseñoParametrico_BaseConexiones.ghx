<?xml version="1.0" encoding="utf-8"?>
<Archive version="3.6.0.0">
  <Object type="Grasshopper.Kernel.GH_Document" name="DiseñoParametrico_BaseConexiones">
    <Name>DiseñoParametrico_BaseConexiones</Name>
    <Description>Canvas base para conexión de scripts con Rhino y ArchiCAD - Diseño Parametrico</Description>
    <Settings>
      <Preview>True</Preview>
      <PreviewMesh>True</PreviewMesh>
      <PreviewGrid>False</PreviewGrid>
      <RemotePanel>False</RemotePanel>
    </Settings>
    <Objects>
      <!-- GRUPO 0: ENTRADAS BASICAS -->
      <Object type="Grasshopper.Kernel.Special.GH_Group" name="G0_Entradas_Basicas">
        <Name>GRUPO 0: ENTRADAS BASICAS</Name>
        <Nickname>GRUPO 0: ENTRADAS BASICAS</Nickname>
        <Color>#FF8C00</Color>
        <Description>Entradas fundamentales: lote, calles adyacentes, vecinos y datos del proyecto</Description>
        <MemberIds>I1000,I1001,I1002,I1003,I1004</MemberIds>
      </Object>

      <!-- INPUT: Lote inicial (polilínea con coordenadas Lat/Long) -->
      <Object type="Grasshopper.Kernel.Parameters.Param_Curve" name="I1000_Lote_Inicial">
        <ID>I1000</ID>
        <Name>Lote Inicial</Name>
        <Nickname>Lote</Nickname>
        <Description>Polilínea del lote de terreno con coordenadas Lat/Long. Este es el punto de partida del proceso de diseño parametrico.</Description>
        <Inputs />
        <Outputs>
          <Output name="Curve" nickname="lote_curva" type="GH_Curve" />
        </Outputs>
        <Attributes>
          <ObjectName>I1000_Lote_Inicial</ObjectName>
          <ObjectType>Grasshopper.Kernel.Parameters.Param_Curve</ObjectType>
          <NickName>Lote</NickName>
          <Name>I1000_Lote_Inicial</Name>
          <Description>Polilínea del lote de terreno con coordenadas Lat/Long</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>I1000_Lote_Inicial</ObjName>
        </Attributes>
      </Object>

      <!-- INPUT: Calles adyacentes (polilíneas) -->
      <Object type="Grasshopper.Kernel.Parameters.Param_Curve" name="I1001_Calles_Adyacentes">
        <ID>I1001</ID>
        <Name>Calles Adyacentes</Name>
        <Nickname>Calles</Nickname>
        <Description>Polilíneas de las calles adyacentes al lote. Estas definen el contexto urbano inmediato y son cruciales para análisis de accesibilidad, flujo vehicular y peatonal.</Description>
        <Inputs />
        <Outputs>
          <Output name="Curve" nickname="calles_curvas" type="GH_Curve" listAccess="True" />
        </Outputs>
        <Attributes>
          <ObjectName>I1001_Calles_Adyacentes</ObjectName>
          <ObjectType>Grasshopper.Kernel.Parameters.Param_Curve</ObjectType>
          <NickName>Calles</NickName>
          <Name>I1001_Calles_Adyacentes</Name>
          <Description>Polilíneas de las calles adyacentes al lote</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>I1001_Calles_Adyacentes</ObjName>
        </Attributes>
      </Object>

      <!-- INPUT: Vecinos modelados como Morph (Geometry) -->
      <Object type="Grasshopper.Kernel.Parameters.Param_GeometryBase" name="I1002_Vecinos_Morph">
        <ID>I1002</ID>
        <Name>Vecinos Morph</Name>
        <Nickname>Vecinos</Nickname>
        <Description>Edificios vecinos modelados como Morphems (Mesh o Brep). Estos representan el contexto edificado existente y son utilizados para análisis de sombras, privilegios visuales, impacto urbano y coherencia tipológica.</Description>
        <Inputs />
        <Outputs>
          <Output name="Geometry" nickname="vecimos_geom" type="GH_Object" listAccess="True" />
        </Outputs>
        <Attributes>
          <ObjectName>I1002_Vecinos_Morph</ObjectName>
          <ObjectType>Grasshopper.Kernel.Parameters.Param_GeometryBase</ObjectType>
          <NickName>Vecinos</NickName>
          <Name>I1002_Vecinos_Morph</Name>
          <Description>Vecinos modelados como Morph</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>I1002_Vecinos_Morph</ObjName>
        </Attributes>
      </Object>

      <!-- INPUT: Tabla de datos de vecinos (dirección, northings, eastings, altura, nombre proyecto) -->
      <Object type="Grasshopper.Kernel.Parameters.Param_GenericObject" name="I1003_Datos_Vecinos">
        <ID>I1003</ID>
        <Name>Datos Vecinos</Name>
        <Nickname>DatosVecinos</Nickname>
        <Description>Tabla de datos asociada a cada vecino morf. Contiene información como: dirección postal, coordenadas UTM (northings, eastings), altitud sobre nivel del mar, nombre del proyecto, altura del edificio, uso de suelo, etc. Estos datos son esenciales para análisis regulatorios, de viabilidad y ambientales.</Description>
        <Inputs />
        <Outputs>
          <Output name="Generic" nickname="datos_vecinos" type="GH_Object" />
        </Outputs>
        <Attributes>
          <ObjectName>I1003_Datos_Vecinos</ObjectName>
          <ObjectType>Grasshopper.Kernel.Parameters.Param_GenericObject</ObjectType>
          <NickName>DatosVecinos</NickName>
          <Name>I1003_Datos_Vecinos</Name>
          <Description>Datos de vecinos (dirección, northings, eastings, altura, nombre proyecto)</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>I1003_Datos_Vecinos</ObjName>
        </Attributes>
      </Object>

      <!-- INPUT: Nombre del proyecto -->
      <Object type="Grasshopper.Kernel.Parameters.Param_String" name="I1004_Nombre_Proyecto">
        <ID>I1004</ID>
        <Name>Nombre Proyecto</Name>
        <Nickname>Proyecto</Nickname>
        <Description>Nombre identificador del proyecto de diseño. Este se utiliza para nombrar outputs, generar reportes y mantener trazabilidad a lo largo de todo el proceso de diseño parametrico.</Description>
        <Inputs />
        <Outputs>
          <Output name="String" nickname="nombre_proyecto" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>I1004_Nombre_Proyecto</ObjectName>
          <ObjectType>Grasshopper.Kernel.Parameters.Param_String</ObjectType>
          <NickName>Proyecto</NickName>
          <Name>I1004_Nombre_Proyecto</Name>
          <Description>Nombre del proyecto</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>I1004_Nombre_Proyecto</ObjName>
        </Attributes>
      </Object>

      <!-- CAPA 0: ANÁLISIS TERRITORIAL BASE (POT BOGOTÁ) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1005_Ctx_Pot_Bogota">
        <ID>N1005</ID>
        <Name>Contexto POT Bogotá</Name>
        <Nickname>CTX_POT_BOGOATA</Nickname>
        <Description>Análisis normativo POT Bogotá consolidado. Procesa las entradas básicas de lote, calles, norte y elevación para generar conclusiones de uso de suelo, tratamiento urbano, límites de altura, análisis vial, restricciones, retiros y reglas de balcones según el POT de Bogotá.</Description>
        <Inputs>
          <Input name="lot_polygon" source="I1000.lote_curva" type="GH_Curve" />
          <Input name="lot_area" type="GH_Number" nickname="Área Lote" value="0" />
          <Input name="lot_centroid" type="GH_Point" nickname="Centroide Lote" />
          <Input name="street_curves" source="I1001.calles_curvas" type="GH_Curve" listAccess="True" />
          <Input name="north_vector" type="GH_Vector" nickname="Vector Norte" />
          <Input name="elevation_nmm" type="GH_Number" nickname="Elevación NMM" value="0" />
        </Inputs>
        <Outputs>
          <Output name="pot_conclusions" nickname="POTConclusions" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1005_Ctx_Pot_Bogota</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>CTX_POT_BOGOATA</NickName>
          <Name>N1005_Ctx_Pot_Bogota</Name>
          <Description>Análisis Normativo POT Bogotá Consolidado</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1005_Ctx_Pot_Bogota</ObjName>
        </Attributes>
        <Code><![CDATA[# CONTEXTO_v04 - Análisis Normativo POT Bogotá Consolidado
# Referencia: C:\Users\Dario Salas\proyectos\DiseñoParametrico_sistema\src\layer0_territorial_base\CTX_POT_BOGOATA_v04.py
