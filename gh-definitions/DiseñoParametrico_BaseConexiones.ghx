      <!-- OPTIMIZADOR ADYACENCIA v01 (Layer 2 - Programming Viability) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1021_Optimizador_Adyacencia">
        <ID>N1021</ID>
        <Name>Optimizador de Adyacencia</Name>
        <Nickname>OPTIMIZADOR ADYACENCIA</Nickname>
        <Description>Optimiza la asignación espacial y análisis de adyacencia entre usos. Utiliza algoritmo de hill climbing con random restarts para maximizar la puntuación basada en matriz de afinidad, compactibilidad, accesibilidad, vistas y servicios. Entradas: programa espacial, restricciones territoriales, geometría del lote, factores de ponderado. Salidas: distribución espacial óptima, matriz de adyacencia evaluada, métricas espaciales, reporte de optimización.</Description>
        <Inputs>
          <Input name="restricciones_json" source="N1010.restricciones_json" type="GH_String" />
          <Input name="lote_curva" source="I1000.lote_curva" type="GH_Curve" />
          <Input name="programa_espacial_json" type="GH_String" nickname="Programa Espacial (m2)" value='{"residencial": 1200, "comercial": 300, "oficinas": 200}' />
          <Input name="pesos_factores_json" type="GH_String" nickname="Pesos Factores" value='{"adyacencia": 0.25, "compactibilidad": 0.20, "accesibilidad": 0.20, "vistas": 0.15, "servicios": 0.20}' />
          <Input name="num_pisos_objetivo" type="GH_Integer" nickname="Número Pisos Objetivo" value="4" />
        </Inputs>
        <Outputs>
          <Output name="distribucion_optima_json" nickname="DistribucionOptimaJSON" type="GH_String" />
          <Output name="matriz_adyacencia_json" nickname="MatrizAdyacenciaJSON" type="GH_String" />
          <Output name="metricas_espaciales_json" nickname="MetricasEspacialesJSON" type="GH_String" />
          <Output name="reporte_optimizacion" nickname="ReporteOptimización" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1021_Optimizador_Adyacencia</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>OPTIMIZADOR ADYACENCIA</NickName>
          <Name>N1021_Optimizador_Adyacencia</Name>
          <Description>Optimizador de Asignación Espacial y Adyacencia</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1021_Optimizador_Adyacencia</ObjName>
        </Attributes>
        <Code><![CDATA[# OPTIMIZADOR_ADYACENCIA_v01.py - Referencia: C:\Users\Dario Salas\proyectos\DiseñoParametrico_sistema\src\layer2_programming_viability\OPTIMIZADOR_ADYACENCIA_v01.py
