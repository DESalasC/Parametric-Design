      <!-- CLUSTER: VIABILIDAD Y PROGRAMACIÓN (Capa 2) -->
      <Object type="Grasshopper.Kernel.Special.GH_Group" name="G2_Viabilidad_Programacion">
        <Name>GRUPO 2: VIABILIDAD Y PROGRAMACIÓN</Name>
        <Nickname>GRUPO 2: VIABILIDAD Y PROGRAMACIÓN</Nickname>
        <Color>#2E8B57</Color>
        <Description>Análisis de viabilidad comercial y programación espacial</Description>
        <MemberIds>N1020,N1021</MemberIds>
      </Object>

      <!-- DEMANDA MOTOR v01 (Layer 2 - Programming Viability) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1020_Demanda_Motor">
        <ID>N1020</ID>
        <Name>Demanda Motor</Name>
        <Nickname>DEMANDA MOTOR</Nickname>
        <Description>Modelos de viabilidad comercial y análisis de demanda. Calcula proyecciones demográficas, indicadores financieros (NPV, IRR, Payback) y valor residual del terreno. Entradas: restricciones territoriales, datos del lote, parámetros económicos. Salidas: JSON con demanda proyectada, indicadores de viabilidad, reporte de mercado.</Description>
        <Inputs>
          <Input name="restricciones_json" source="N1010.restricciones_json" type="GH_String" />
          <Input name="lote_area" type="GH_Number" nickname="Área Lote (m2)" value="1000.0" />
          <!-- En una implementación completa, el área del lote vendría de un componente Area conectado a lote_curva -->
        </Inputs>
        <Outputs>
          <Output name="demanda_proyectada_json" nickname="DemandaProyectadaJSON" type="GH_String" />
          <Output name="indicadores_viabilidad_json" nickname="IndicadoresViabilidadJSON" type="GH_String" />
          <Output name="reporte_mercado" nickname="ReporteMercado" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1020_Demanda_Motor</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
          <NickName>DEMANDA MOTOR</NickName>
          <Name>N1020_Demanda_Motor</Name>
          <Description>Modelo de Demanda y Viabilidad</Description>
          <Exposure>-7</Exposure>
          <IGNOUNO>-1</IGNOUNO>
          <Locked>false</Locked>
          <Hidden>false</Hidden>
          <ObjName>N1020_Demanda_Motor</ObjName>
        </Attributes>
        <Code><![CDATA[# DEMANDA_MOTOR_v01.py - Referencia: C:\Users\Dario Salas\proyectos\DiseñoParametrico_sistema\src\layer2_programming_viability\DEMANDA_MOTOR_v01.py
