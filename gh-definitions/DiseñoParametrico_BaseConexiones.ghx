      <!-- LADYBUG ANALISIS v02 (Nuestro componente recientemente creado) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1032_Ladybug_Analisis">
        <ID>N1032</ID>
        <Name>Ladybug Análisis</Name>
        <Nickname>LADYBUG ANÁLISIS</Nickname>
        <Description>Realiza análisis ambientales usando las bibliotecas de Ladybug. Incluye análisis de radiación solar, iluminancia natural, confort térmico, y otros estudios ambientales para el diseño arquitectónico sostenible. Entradas: JSON preparado por PREP_LADYBUG_v01, tipo de análisis, período, parámetros específicos. Salidas: Resultados completos en JSON, estadísticas, reporte legible, visualizaciones, datos preparados para posible uso en Honeybee.</Description>
        <Inputs>
          <Input name="ladybug_entrada_json" source="N1030.ladybug_entrada_json" type="GH_String" />
          <Input name="analisis_parametros_json" source="N1030.analisis_parametros_json" type="GH_String" />
