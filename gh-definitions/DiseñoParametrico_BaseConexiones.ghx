      <!-- CLUSTER: PREPARACIÓN LADYBUG (Capa 3 y 4) -->
      <Object type="Grasshopper.Kernel.Special.GH_Group" name="G3_Preparacion_Ladybug">
        <Name>GRUPO 3: PREPARACIÓN LADYBUG</Name>
        <Nickname>GRUPO 3: PREPARACIÓN LADYBUG</Nickname>
        <Color>#DC143C</Color>
        <Description>Preparación de datos y geometría para análisis ambiental con Ladybug/Honeybee</Description>
