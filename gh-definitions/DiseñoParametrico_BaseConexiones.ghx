          <Output name="reporte_analisis_txt" nickname="ReporteAnálisisTXT" type="GH_String" />
          <Output name="datos_visualizacion_json" nickname="DatosVisualizaciónJSON" type="GH_String" />
          <Output name="datos_para_honeybee_json" nickname="DatosParaHoneybeeJSON" type="GH_String" />
