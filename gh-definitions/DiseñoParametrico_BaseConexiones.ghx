      <!-- CAPA 1: ANÁLISIS DE VECINOS (NSR-10) -->
      <Object type="Grasshopper.Kernel.Components.PythonScript" name="N1007_Vecinos_Analisis">
        <ID>N1007</ID>
        <Name>Análisis de Vecinos</Name>
        <Nickname>VECINOS_ANALISIS</Nickname>
        <Description>Análisis de edificios vecinos para parámetros NSR-10. Proporciona información sobre zona sísmica, tipo de suelo, altura máxima permitida y retiros según normas NSR-10 para validación cruzada con POT.</Description>
        <Inputs>
          <Input name="datos_vecinos" source="I1003.datos_vecinos" type="GH_Object" />
          <Input name="lot_polygon" source="I1000.lote_curva" type="GH_Curve" />
          <Input name="street_curves" source="I1001.calles_curvas" type="GH_Curve" listAccess="True" />
        </Inputs>
        <Outputs>
          <Output name="vecino_analisis_json" nickname="VecinoAnalisisJSON" type="GH_String" />
          <Output name="zon_sismica" nickname="ZonaSismica" type="GH_String" />
          <Output name="tipo_suelo" nickname="TipoSuelo" type="GH_String" />
          <Output name="altura_maxima_permitida" type="GH_Number" nickname="Altura Máxima Permitida" value="0" />
          <Output name="setbacks_nsr10" nickname="SetbacksNSR10" type="GH_String" />
        </Outputs>
        <Attributes>
          <ObjectName>N1007_Vecinos_Analisis</ObjectName>
          <ObjectType>Grasshopper.Kernel.Components.PythonScript</ObjectType>
