# F1_CONTEXTO_POT_v09.py - Procesamiento del contexto POT
import sys
import os
import json
import math

# Añadir la ruta del proyecto al sys.path
project_root = os.environ.get("DISENO_PARAMETRICO_ROOT", r"D:\Work\PROJECTS\DiseñoParametrico")
script_path = os.path.join(project_root, "src", "fase-1-contexto", "F1_CONTEXTO_POT_v09.py")
if os.path.exists(script_path):
    sys.path.append(os.path.dirname(script_path))
    # Variables de entrada esperadas:
    # lot_polygon, lot_centroid, lot_area, street_curves, geo_json_features,
    # tratamiento_features, sector_features, north_vector
    exec(open(script_path).read())
else:
    # Fallback a ruta relativa
    fallback_path = r"src\fase-1-contexto\F1_CONTEXTO_POT_v09.py"
    if os.path.exists(fallback_path):
        exec(open(fallback_path).read())
    else:
        raise FileNotFoundError(f"No se encontró F1_CONTEXTO_POT_v09.py en {script_path} ni {fallback_path}")
]]></Code>
