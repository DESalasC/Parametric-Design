# F1_LADOS_CONFIGURAR_v07.py - Clasificación mejorada con distancia y alineación
import sys
import os
# Añadir la ruta del proyecto al sys.path
project_root = os.environ.get("DISENO_PARAMETRICO_ROOT", r"D:\Work\PROJECTS\DiseñoParametrico")
script_path = os.path.join(project_root, "src", "fase-1-contexto", "F1_LADOS_CONFIGURAR_v07.py")
if os.path.exists(script_path):
    sys.path.append(os.path.dirname(script_path))
    exec(open(script_path).read())
else:
    # Fallback a ruta relativa si la variable de entorno no está definida
    fallback_path = r"src\fase-1-contexto\F1_LADOS_CONFIGURAR_v07.py"
    if os.path.exists(fallback_path):
        exec(open(fallback_path).read())
    else:
        raise FileNotFoundError(f"No se encontró F1_LADOS_CONFIGURAR_v07.py en {script_path} ni {fallback_path}")
]]></Code>
