                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">dafc8a9a-71c0-4c6f-96ed-ff5a9b0a540e</item>
                            <item name="Name" type_name="gh_string" type_code="10">mensaje</item>
                            <item name="NickName" type_name="gh_string" type_code="10">mensaje</item>
