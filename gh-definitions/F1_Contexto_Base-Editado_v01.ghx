                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_EXPORTAR_GFA_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">50b59759-886e-459e-ac8f-e64499eda092</item>
                            <item name="Name" type_name="gh_string" type_code="10">gfa_total</item>
                            <item name="NickName" type_name="gh_string" type_code="10">gfa_total</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="ScriptParamAccess" type_name="gh_int32" type_code="3">0</item>
                            <item name="ShowTypeHints" type_name="gh_bool" type_code="1">true</item>
