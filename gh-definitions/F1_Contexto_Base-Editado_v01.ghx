                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_ETAPA2_NORMATIVA_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">09f1ea1c-bc33-41ea-a68b-9ae965936f8e</item>
                            <item name="Name" type_name="gh_string" type_code="10">rango_edificabilidad</item>
                            <item name="NickName" type_name="gh_string" type_code="10">rango_edificabilidad</item>
