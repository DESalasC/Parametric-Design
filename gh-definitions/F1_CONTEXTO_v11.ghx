              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os

# Lee la variable de entorno (sin los caracteres %)
root_path = os.getenv("DISENO_PARAMETRICO_ROOT")

if root_path:
    # Envía el resultado a la salida 'a'
    a = root_path
else:
    print("Advertencia: La variable de entorno no está definida.")
    a = None
    </item>
