                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os

# Leer la variable de entorno
root_str = os.getenv("DISENO_PARAMETRICO_ROOT")

if root_str is None:
    mensaje = "La variable DISENO_PARAMETRICO_ROOT no está definida."
else:
    mensaje = str(root_str)

# Salida del componente
a = mensaje</item>
