                  <items count="7">
                    <item name="Description" type_name="gh_string" type_code="10">Boolean (true/false) toggle</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">cec00a6d-b355-4ca1-9659-7362d5f52ae2</item>
                    <item name="Name" type_name="gh_string" type_code="10">Boolean Toggle</item>
                    <item name="NickName" type_name="gh_string" type_code="10">#85-Boolean Toggle</item>
                    <item name="Optional" type_name="gh_bool" type_code="1">false</item>
