                        <chunk name="InputParam" index="3">
                          <items count="11">
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_EXPORTAR_GFA_v01</item>
