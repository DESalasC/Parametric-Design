                <item name="Name" type_name="gh_string" type_code="10">Tapir</item>
                <item name="Version" type_name="gh_string" type_code="10">1.7.1</item>
              </items>
            </chunk>
            <chunk name="Library" index="7">
              <items count="6">
                <item name="AssemblyFullName" type_name="gh_string" type_code="10">Bifocals, Version=0.5.0.0, Culture=neutral, PublicKeyToken=null</item>
                <item name="AssemblyVersion" type_name="gh_string" type_code="10">0.5.0.0</item>
                <item name="Author" type_name="gh_string" type_code="10">Marc Syp</item>
                <item name="Id" type_name="gh_guid" type_code="9">9bde5adf-1aa6-414c-a1d4-8832edea1934</item>
                <item name="Name" type_name="gh_string" type_code="10">Bifocals</item>
                <item name="Version" type_name="gh_string" type_code="10" />
              </items>
            </chunk>
            <chunk name="Library" index="8">
              <items count="6">
                <item name="AssemblyFullName" type_name="gh_string" type_code="10">ArchicadConnection, Version=29.0.0.3000, Culture=neutral, PublicKeyToken=null</item>
                <item name="AssemblyVersion" type_name="gh_string" type_code="10">29.0.0.3000</item>
                <item name="Author" type_name="gh_string" type_code="10">GRAPHISOFT SE</item>
                <item name="Id" type_name="gh_guid" type_code="9">b267c457-1b3b-42eb-94d4-a075bfc97888</item>
                <item name="Name" type_name="gh_string" type_code="10">Grasshopper-Archicad Live Connection built for Rhinoceros 8</item>
                <item name="Version" type_name="gh_string" type_code="10">29.0.0.3000</item>
              </items>
            </chunk>
          </chunks>
        </chunk>
        <chunk name="DefinitionObjects">
          <items count="1">
            <item name="ObjectCount" type_name="gh_int32" type_code="3">380</item>
          </items>
          <chunks count="380">
            <chunk name="Object" index="0">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
