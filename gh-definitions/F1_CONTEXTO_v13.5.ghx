                        <chunk name="InputParam" index="3">
                          <items count="11">
                            <item name="Access" type_name="gh_int32" type_code="3">1</item>
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F3_MORPH_ATRIBUTOS_v02</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">6c761dcf-bc80-4b5d-8958-b47ba2c147a7</item>
                            <item name="Name" type_name="gh_string" type_code="10">nombres_niveles</item>
                            <item name="NickName" type_name="gh_string" type_code="10">nombres_niveles</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="ScriptParamAccess" type_name="gh_int32" type_code="3">1</item>
