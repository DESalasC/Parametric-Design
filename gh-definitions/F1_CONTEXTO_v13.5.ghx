ESCALERA_ANCHO_M = 2.7
ESCALERA_LARGO_M = 5.0
ASCENSOR_ANCHO_M = 2.2
ASCENSOR_LARGO_M = 2.2
SERVICIOS_ANCHO_M = 2.0
SERVICIOS_LARGO_M = 4.0
UNID_POR_ASCENSOR = 40.0
