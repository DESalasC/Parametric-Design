                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">0d986a36-a41a-429c-8f29-9e2658659e25</item>
                    <item name="IsAdvancedMode" type_name="gh_bool" type_code="1">false</item>
                    <item name="MarshalOutGuids" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">F1_ETAPA1_CONTEXTO_v02</item>
                  </items>
                  <chunks count="2">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>439</X>
                          <Y>151</Y>
                          <W>196</W>
                          <H>304</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>510</X>
                          <Y>303</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="ParameterData">
