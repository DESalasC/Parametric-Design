                        <chunk name="InputParam" index="1">
                          <items count="11">
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_ETAPA2_PATIO_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">77dbc3cd-4dbe-4ea0-aecd-e572162fb05c</item>
                            <item name="Name" type_name="gh_string" type_code="10">sides_table_json</item>
                            <item name="NickName" type_name="gh_string" type_code="10">sides_table_json</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
