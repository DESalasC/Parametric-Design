  --prioridad-ajuste              "profundidad,entrepiso,num_cuerpos"
  --usos                          "Vivienda,Local comercial" (filtra mix D_MIXTO)
  --bloques-separacion-m          Separación mínima base (default 6.0)
  --bloques-crujia                "unica" | "doble" (default unica)
