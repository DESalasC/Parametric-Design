                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F3_VOLUM_GENERADOR_v08</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">b2507be4-b0dc-4959-b3eb-c861dbd69fe4</item>
                            <item name="Name" type_name="gh_string" type_code="10">salida_morph</item>
                            <item name="NickName" type_name="gh_string" type_code="10">salida_morph</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="ScriptParamAccess" type_name="gh_int32" type_code="3">0</item>
