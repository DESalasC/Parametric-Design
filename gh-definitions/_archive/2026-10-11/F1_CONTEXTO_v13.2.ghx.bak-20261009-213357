def build_payload():
    warnings = []
    chip_str = derivar_chip(json_path)
    if chip_str == "": warnings.append("no se pudo derivar CHIP del json_path")

    # MODO APROBADO: gfa_aprobado_m2 &gt; 0 y valido=True
    modo_aprobado = (gfa_aprobado_m2 is not None and
