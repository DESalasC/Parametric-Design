    lfo=float(_u(globals().get("lote_fondo_m",0)) or 0)
    # Fallback: si no vienen de F1, calcular desde envelope del layout
    if (lf &lt;= 0 or lfo &lt;= 0) and lay and lay.get("niveles"):
