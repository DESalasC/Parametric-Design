    if val:
        print("\n&gt;&gt;&gt; MODO VALIDACION: Revisar prevalidacion_*.txt antes de proceder")

def _u(v):
    if v is None: return None
    if hasattr(v,"Value"): return v.Value
    # GH a veces entrega listas de 1 elemento en lugar del valor directo
    if isinstance(v, (list, tuple)) and len(v) &gt; 0:
        return _u(v[0])
    return v
def _pj(v):
    """Parsea JSON desde string, archivo, o retorna dict/list si ya está parseado."""
    if v is None:
        return None
    # Si ya es dict o list, retornarlo directamente (IMPORTANTE: antes de str())
    if isinstance(v, (dict, list)):
        return v
    s = str(v).strip()
    # Si es ruta a archivo .json
    if s.endswith(".json") and os.path.exists(s):
        return load_json(s)
    # Si es string JSON, parsearlo
    try: return json.loads(s)
    except: return None

def _raiz_casos():
    """v02.2 - Localiza src/fase-3-masa/casos (archivo / entorno / cwd)."""
    raices = []
    try:
        base = os.path.dirname(os.path.abspath(__file__))
        raices.append(os.path.join(base, "casos"))
    except Exception:
        pass
    try:
        env_root = os.environ.get("DISENO_PARAMETRICO_ROOT", "")
        if env_root:
            raices.append(os.path.join(env_root, "src", "fase-3-masa", "casos"))
    except Exception:
        pass
    p = os.getcwd()
    for _i in range(6):
        raices.append(os.path.join(p, "src", "fase-3-masa", "casos"))
        np_ = os.path.dirname(p)
        if np_ == p:
            break
        p = np_
    for r in raices:
        try:
            if r and os.path.isdir(r):
                return r
        except Exception:
            pass
    return ""

def _layout_de_disco(chip):
    """v02.2 - Respaldo: layout_espacial.json desde casos/&lt;chip&gt;/ o el mas reciente."""
    casos = _raiz_casos()
    if not casos:
        return None, ""
    candidatos = []
    if chip:
        ruta = os.path.join(casos, str(chip), "layout_espacial.json")
        if os.path.isfile(ruta):
            datos_chip = load_json(ruta)
            if datos_chip and isinstance(datos_chip, dict) and (datos_chip.get("reparto_vertical") or datos_chip.get("niveles")):
                return datos_chip, ruta
    try:
        for nombre in os.listdir(casos):
            ruta = os.path.join(casos, nombre, "layout_espacial.json")
            if os.path.isfile(ruta):
                candidatos.append(ruta)
    except Exception:
        pass
    mejor = None
    for ruta in candidatos:
        try:
            m = os.path.getmtime(ruta)
        except Exception:
            m = 0
        if mejor is None or m &gt; mejor[0]:
            mejor = (m, ruta)
    if mejor is None:
        return None, ""
    datos = load_json(mejor[1])
    if datos and isinstance(datos, dict) and (datos.get("reparto_vertical") or datos.get("niveles")):
        return datos, mejor[1]
    return None, ""

def _gh():
    # Debug: listar todas las globales disponibles para diagnosticar nombres de entradas
    try:
        gh_globals = [k for k in globals().keys() if not k.startswith('_') and k not in ['json', 'os', 'sys', 'math', 'rg', 'io', 'load_json', 'resolve', 'rect', 'area', 'rot', 'bbox', 'distribuir_piso', 'calc_parqueaderos', 'generar', 'to_volum', 'prevalidacion', 'main', '_u', '_pj', '_gh', '_es_gh', 'gh_inputs', 'inp', 'TIPOLOGIAS_BASE', 'USO_LAYOUT_A_OBJETIVO', 'ANCHO_PASILLO_MIN', 'ANCHO_PASILLO_PREF', 'AREA_MIN_VIV_VIS', 'AREA_MIN_VIV_EST', 'AREA_MIN_LOCAL', 'PROF_MAX_VIV_FACHADA', 'PROF_MAX_VIV_2FACHADAS', 'PROF_MAX_LOCAL', 'RECORRIDO_MAX_EVAC', 'PARQ_VIV', 'PARQ_COM_100M2', 'AREA_PARQ_UND', 'AREA_PARQ_CIRC']]
    except:
        gh_globals = []

    # Intentar múltiples nombres posibles para layout (compatibilidad con diferentes cableados)
    lay = None
    tried_names = []
    for layout_name in ["layout_espacial_json", "layout_json", "layoutEspacialJson", "layout_espacial", "LayoutEspacialJson", "layout-espacial-json"]:
        tried_names.append(layout_name)
        val = globals().get(layout_name)
        if val is not None:
            cand = _pj(_u(val))
            if isinstance(cand, dict) and (cand.get("reparto_vertical") or cand.get("niveles")):
                lay = cand
                break

    # Si aún no hay layout, intentar buscar en todas las globales que contengan "layout" o "espacial"
    if not lay:
        # v02.2: buscar por nombre con validacion de contenido (evita falsos positivos)
        for k, v in globals().items():
            kl = k.lower()
            if k.startswith('_') or k in ('USO_LAYOUT_A_OBJETIVO',):
                continue
            if ('layout' in kl or 'espacial' in kl) and v is not None:
                tried_names.append(k)
                cand = _pj(_u(v))
                if isinstance(cand, dict) and (cand.get("reparto_vertical") or cand.get("niveles")):
                    lay = cand
                    break

    f2=_pj(_u(globals().get("f2_resultados_json")))
    cota=float(_u(globals().get("cota_via_m",0)) or 0)
    chip=_u(globals().get("chip")) or "chip"
    _layout_fuente = ""
    if not lay:
        # v02.2: respaldo - layout desde disco si el cableado no lo entrego
        lay, _lay_ruta = _layout_de_disco(chip)
        if lay:
            _layout_fuente = _lay_ruta
    ang=math.radians(float(_u(globals().get("angulo_fachada_deg",0)) or 0))
