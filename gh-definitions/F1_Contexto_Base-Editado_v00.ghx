                        <chunk name="OutputParam" index="3">
                          <items count="6">
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_ETAPA1_CONTEXTO_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">dfd2b0b2-60b7-4ab3-b52e-f63907bfeacd</item>
                            <item name="Name" type_name="gh_string" type_code="10">vias_oficiales</item>
