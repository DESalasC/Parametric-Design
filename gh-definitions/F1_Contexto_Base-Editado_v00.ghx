                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_ETAPA1_CONTEXTO_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">26fca09d-a7fe-4793-8c7a-b1bf3d4cda86</item>
                            <item name="Name" type_name="gh_string" type_code="10">espacios_publicos</item>
