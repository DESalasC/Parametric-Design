            <chunk name="Object" index="4">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
================================================================================
F1_ETAPA2_LADOS_v02.py — Algoritmo Vertice A / Vertice N (Fix Colindancia)
Proyecto: DisenoParametrico / Fase 1
GH Python Script para Grasshopper (IronPython 2.7 compatible)
================================================================================

ALGORITMO:
  1. Para cada vertice del lote simplificado, calcular la distancia minima
     a las vias que afectan el lote.
  2. VERTICE A = vertice con MENOR distancia a vias (frente).
  3. VERTICE N = vertice con MAYOR distancia (fondo).
  4. Lados que comparten N se clasifican por colindancia. Si no hay via 
     contundente, se fuerzan a "Lateral" para permitir generacion de patio.
  5. Lados que comparten A -&gt; Frontal.

ENTRADAS:
  lot_vertices (Point3d[])     — 4 vertices desde Discontinuity
  vias_curves (Curve[])        — Ejes de vias / Poligonos viales
  ep_curves (Curve[])          — Zonas verdes (capa 70-50-10)
  vecinos_curves (Curve[])     — Perimetros vecinos (capa 70-20-20)

SALIDAS:
  sides_table_json (String) — Clasificacion + vertice_a + vertice_n
  lot_simplificado (Curve)  — Poligono de 4 vertices
  es_esquina (bool)         — True si hay 2+ vertices frontales
  mensaje (String)          — Diagnostico
================================================================================
"""

import Rhino.Geometry as rg
import json
import math

# Reducida de 0.5 a 0.15 para evitar falsos positivos catastrales
TOL_COLINDANCIA_M = 0.15 
RADIO_VIA_M = 50.0
# Angulo maximo (en grados) para considerar que una curva es paralela al lado
TOL_ANGULO_PARALELO = 20.0 

def safe_list(val):
    if val is None: return []
    if isinstance(val, list): return val
    return [val]

def get_tangent_at(curva, param):
    """Obtiene el vector tangente de la curva en un parametro."""
    try:
        tan = curva.TangentAt(param)
        # Forzamos plano XY para ignorar pendientes Z
        return rg.Vector3d(tan.X, tan.Y, 0)
    except:
        return None

def curva_toca_segmento(p1, p2, curva, tol=TOL_COLINDANCIA_M):
    """
    Verifica si una curva toca el segmento de manera contundente.
    Comprueba distancia Y paralelismo para evitar cruzes perpendiculares.
    """
    if curva is None:
        return False
    
    long_seg = p1.DistanceTo(p2)
    if long_seg &lt; 0.01:
        return False
        
    vec_seg = rg.Vector3d(p2.X - p1.X, p2.Y - p1.Y, 0)
    vec_seg.Unitize()
    
    # Muestreo denso a lo largo del segmento
    muestras = max(5, int(long_seg / 0.5) + 1)
    tocas = 0
    
    for i in range(muestras):
        t = float(i) / max(1, muestras - 1)
        pt = rg.Point3d(p1.X + t * (p2.X - p1.X),
                        p1.Y + t * (p2.Y - p1.Y), 0)
        success, param = curva.ClosestPoint(pt)
        if success:
            closest = curva.PointAt(param)
            d = pt.DistanceTo(closest)
            
            # 1. Validar distancia estricta
            if d &lt; tol:
                # 2. Validar paralelismo (angulo entre vectores)
                tan = get_tangent_at(curva, param)
                if tan is not None:
                    tan.Unitize()
                    # Producto punto nos da el coseno del angulo
                    dot = abs(vec_seg.X * tan.X + vec_seg.Y * tan.Y)
                    angulo_rad = math.acos(max(-1.0, min(1.0, dot)))
                    angulo_deg = math.degrees(angulo_rad)
                    
                    # Si son paralelos o casi paralelos (&lt; 20 grados de diff)
                    if angulo_deg &lt; TOL_ANGULO_PARALELO:
                        tocas += 1
                        
    # Requerimos al menos 2 puntos cercanos paralelos para confirmar colindancia
    return tocas &gt;= 2

def lado_colindante(p1, p2, curvas):
    for crv in curvas:
        if crv is not None and curva_toca_segmento(p1, p2, crv):
            return True
    return False

def distancia_vertice_a_curvas(vertice, curvas, max_dist):
    mejor = max_dist + 1
    for crv in curvas:
        if crv is None:
            continue
        success, param = crv.ClosestPoint(vertice)
        if success:
            d = vertice.DistanceTo(crv.PointAt(param))
            if d &lt; mejor:
                mejor = d
    return mejor

# ==============================================================================
# MAIN
# ==============================================================================

lot_vertices_raw = globals().get("lot_vertices", None)
vias_raw = globals().get("vias_curves", None)
ep_raw = globals().get("ep_curves", None)
vecinos_raw = globals().get("vecinos_curves", None)

lot_vertices = safe_list(lot_vertices_raw)
vias_list = safe_list(vias_raw)
ep_list = safe_list(ep_raw)
vecinos_list = safe_list(vecinos_raw)

sides_table_json = ""
lot_simplificado = None
es_esquina = False

if len(lot_vertices) &lt; 3:
    mensaje = "LADOS v02 | ERROR: Se necesitan &gt;= 3 vertices ({} recibidos)".format(len(lot_vertices))
else:
    try:
        n = len(lot_vertices)

        # Reconstruir poligono
        poly = rg.Polyline()
        for v in lot_vertices:
            poly.Add(v.X, v.Y, v.Z)
        if not poly.IsClosed and n &gt;= 3:
            poly.Add(lot_vertices[0].X, lot_vertices[0].Y, lot_vertices[0].Z)
        lot_simplificado = rg.PolylineCurve(poly)

        # Distancias a vias
        dist_vertices = []
        for v in lot_vertices:
            d = distancia_vertice_a_curvas(v, vias_list, RADIO_VIA_M)
            dist_vertices.append(d)

        # Vertice A (frente) y Vertice N (fondo)
        idx_a = dist_vertices.index(min(dist_vertices))
        idx_n = dist_vertices.index(max(dist_vertices))
        vertice_a = idx_a
        vertice_n = idx_n

        UMBRAL_FRONTAL = 15.0
        vertices_frontales = [i for i, d in enumerate(dist_vertices) if d &lt; UMBRAL_FRONTAL]
        es_esquina = len(vertices_frontales) &gt;= 2

        lados = []
        for i in range(n):
            j = (i + 1) % n
            p1 = lot_vertices[i]
            p2 = lot_vertices[j]

            comparte_a = (i == idx_a or j == idx_a)
            comparte_n = (i == idx_n or j == idx_n)

            toca_via = lado_colindante(p1, p2, vias_list)
            toca_ep = lado_colindante(p1, p2, ep_list)
            toca_vecino = lado_colindante(p1, p2, vecinos_list)

            # Logica de clasificacion priorizada
            if toca_via:
                cat = "Frontal"
            elif toca_ep:
                cat = "EspacioPublico"
            elif toca_vecino:
                cat = "Lateral"
            elif comparte_a:
                cat = "Frontal"
            elif comparte_n:
                # FIX OVERRIDE: El vertice N es el fondo. Si no toca vía duro,
                # DEBE ser Lateral o Posterior para que el patio pueda formarse.
                # Si hay vecinos en el sistema, asumimos Lateral.
                if len(vecinos_list) &gt; 0:
                    cat = "Lateral"
                else:
                    cat = "Posterior"
            else:
                cat = "Lateral"

            lados.append({
                "id": i,
                "clasificacion": cat,
                "toca_via": toca_via,
                "toca_ep": toca_ep,
                "toca_vecino": toca_vecino,
                "dist_v_m": round(dist_vertices[i], 2),
                "comparte_a": comparte_a,
                "comparte_n": comparte_n
            })

        # Post-procesamiento de Posterior
        categorias = [l["clasificacion"] for l in lados]
        n_frontales = categorias.count("Frontal")
        if n_frontales == 1 and n == 4:
            idx_frontal = categorias.index("Frontal")
            idx_op = (idx_frontal + 2) % 4
            if lados[idx_op]["clasificacion"] == "Lateral" and not lados[idx_op]["toca_vecino"]:
                lados[idx_op]["clasificacion"] = "Posterior"

        sides_data = {
            "lados": lados,
            "total_lados": len(lados),
            "vertice_a": vertice_a,
            "vertice_n": vertice_n,
            "distancias_vertices": [round(d, 2) for d in dist_vertices],
            "es_esquina": es_esquina,
            "regla": "Vertice A/N + colindancia estricta paralela"
        }
        sides_table_json = json.dumps(sides_data)

        cats_final = [l["clasificacion"] for l in lados]
        mensaje = "LADOS v02 | A=V{} N=V{} | {} | Esq:{} | Vias:{} EP:{} Vec:{}".format(
            vertice_a, vertice_n, ", ".join(cats_final),
            es_esquina, len(vias_list), len(ep_list), len(vecinos_list))

    except Exception as e:
        mensaje = "LADOS v02 | ERROR: {}".format(str(e))
        </item>
                    <item name="Description" type_name="gh_string" type_code="10">================================================================================
F1_ETAPA2_LADOS_v02.py — Algoritmo Vertice A / Vertice N (Fix Colindancia)
Proyecto: DisenoParametrico / Fase 1
GH Python Script para Grasshopper (IronPython 2.7 compatible)
================================================================================
ALGORITMO:
  1. Para cada vertice del lote simplificado, calcular la distancia minima
a las vias que afectan el lote.
  2. VERTICE A = vertice con MENOR distancia a vias (frente).
  3. VERTICE N = vertice con MAYOR distancia (fondo).
  4. Lados que comparten N se clasifican por colindancia. Si no hay via 
contundente, se fuerzan a "Lateral" para permitir generacion de patio.
  5. Lados que comparten A -&gt; Frontal.
ENTRADAS:
  lot_vertices (Point3d[])     — 4 vertices desde Discontinuity
  vias_curves (Curve[])        — Ejes de vias / Poligonos viales
  ep_curves (Curve[])          — Zonas verdes (capa 70-50-10)
  vecinos_curves (Curve[])     — Perimetros vecinos (capa 70-20-20)
SALIDAS:
  sides_table_json (String) — Clasificacion + vertice_a + vertice_n
  lot_simplificado (Curve)  — Poligono de 4 vertices
  es_esquina (bool)         — True si hay 2+ vertices frontales
  mensaje (String)          — Diagnostico
================================================================================</item>
