                        <chunk name="InputParam" index="3">
                          <items count="11">
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">Script variable F1_ETAPA2_NORMATIVA_v01</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">6c609e4d-c180-4f5f-9f53-7112a22a179c</item>
