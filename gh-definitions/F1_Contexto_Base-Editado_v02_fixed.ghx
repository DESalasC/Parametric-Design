                        },
                        {
                          "Path": "Definition/DefinitionObjects/Object/Container/ParameterData/OutputParam",
                          "Items": [
                            {
                              "Name": "Description",
                              "Value": "Script variable F1_ETAPA1_CONTEXTO_v01"
                            },
                            {
                              "Name": "InstanceGuid",
                              "Value": "f8930226-5da5-4fd3-92ae-c01c81453edf"
                            },
                            {
                              "Name": "Name",
                              "Value": "mensaje"
                            },
                            {
                              "Name": "NickName",
                              "Value": "mensaje"
                            },
                            {
