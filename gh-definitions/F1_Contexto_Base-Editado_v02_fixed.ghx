                            }
                          ]
                        },
                        {
                          "Path": "Definition/DefinitionObjects/Object/Container/ParameterData/OutputParam",
                          "Items": [
                            {
                              "Name": "Description",
                              "Value": "Script variable F1_ETAPA2_PATIO_v01"
                            },
                            {
                              "Name": "InstanceGuid",
                              "Value": "dafc8a9a-71c0-4c6f-96ed-ff5a9b0a540e"
                            },
                            {
                              "Name": "Name",
                              "Value": "mensaje"
                            },
