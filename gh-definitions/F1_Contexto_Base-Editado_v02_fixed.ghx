                    }
                  ],
                  "Children": [
                    {
                      "Path": "Definition/DefinitionObjects/Object/Container/Attributes",
                      "Items": [
                        {
                          "Name": "Bounds",
                          "Value": "{X=2734,Y=333,Width=160,Height=48}"
                        },
                        {
                          "Name": "MarginLeft",
