                        },
                        {
                          "Name": "Pivot",
                          "Value": "{X=2734.9543, Y=333.85944}"
                        }
                      ],
                      "Children": []
                    },
                    {
                      "Path": "Definition/DefinitionObjects/Object/Container/PanelProperties",
                      "Items": [
                        {
                          "Name": "Colour",
                          "Value": "Color [A=255, R=255, G=250, B=90]"
                        },
