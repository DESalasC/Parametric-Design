                              "Name": "SourceCount",
                              "Value": "0"
                            }
                          ],
                          "Children": [
                            {
                              "Path": "Definition/DefinitionObjects/Object/Container/ParameterData/OutputParam/Attributes",
                              "Items": [
                                {
                                  "Name": "Bounds",
                                  "Value": "{X=435,Y=449,Width=108,Height=20}"
                                },
