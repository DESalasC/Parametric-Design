                            <item name="Description" type_name="gh_string" type_code="10">Script variable Python</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">0d0cfd98-43fc-49f1-b97b-71e2de29ff4b</item>
                            <item name="Name" type_name="gh_string" type_code="10">sides_table_json</item>
                            <item name="NickName" type_name="gh_string" type_code="10">sides_table_json</item>
